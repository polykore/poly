<Window
    x:Class="PolyTerminal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Poly Terminal">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- minimal win11 tabview control -->
        <TabView x:Name="MainTabView" 
                 Background="Transparent"
                 AddTabButtonClick="MainTabView_AddTabButtonClick" 
                 TabCloseRequested="MainTabView_TabCloseRequested" 
                 IsAddTabButtonVisible="True">
        </TabView>

        <!-- sleek bottom-right floating settings cog button -->
        <Button x:Name="SettingsButton" 
                Click="SettingsButton_Click" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,16,14" 
                Canvas.ZIndex="999"
                Background="#1F2937" 
                CornerRadius="16"
                BorderBrush="#374151"
                BorderThickness="1" 
                Padding="10,8" 
                ToolTipService.ToolTip="Settings (Ctrl+Alt+S)">
            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#9CA3AF"/>
        </Button>
    </Grid>
</Window>
