<UserControl
    x:Class="PolyTerminal.Controls.TerminalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerPressed="UserControl_PointerPressed">

    <Grid RowDefinitions="*,Auto" Padding="16,12" Background="Transparent">
        <!-- full-height terminal output area -->
        <ScrollViewer x:Name="OutputScrollViewer" 
                      Grid.Row="0" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <TextBlock x:Name="OutputTextBlock" 
                       FontFamily="Cascadia Mono, Cascadia Code, Consolas" 
                       FontSize="13" 
                       Foreground="#E6EDF3" 
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- aligned bottom input prompt -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0" Background="Transparent" VerticalAlignment="Center">
            <TextBlock x:Name="PromptLabel" Grid.Column="0" 
                       Text="user@terminal:~ ❯ " 
                       FontFamily="Cascadia Mono, Cascadia Code, Consolas" 
                       FontSize="13" 
                       Foreground="#58A6FF" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold"
                       Margin="0,0,2,0"/>
            
            <!-- command input box -->
            <TextBox x:Name="InputTextBox" Grid.Column="1" 
                     FontFamily="Cascadia Mono, Cascadia Code, Consolas" 
                     FontSize="13" 
                     Foreground="#FFFFFF"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="0"
                     MinHeight="0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     CornerRadius="0"
                     KeyDown="InputTextBox_KeyDown">
                <TextBox.Resources>
                    <Thickness x:Key="TextControlThemePadding">0,0,0,0</Thickness>
                    <Thickness x:Key="TextControlMargin">0,0,0,0</Thickness>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                </TextBox.Resources>
            </TextBox>

            <!-- password input box (sudo prompt, in grid.column="1" immediately next to prompt) -->
            <PasswordBox x:Name="InputPasswordBox" Grid.Column="1"
                         FontFamily="Cascadia Mono, Cascadia Code, Consolas"
                         FontSize="13"
                         Foreground="#FFFFFF"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0"
                         MinHeight="0"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         CornerRadius="0"
                         KeyDown="InputPasswordBox_KeyDown">
                <PasswordBox.Resources>
                    <Thickness x:Key="TextControlThemePadding">0,0,0,0</Thickness>
                    <Thickness x:Key="TextControlMargin">0,0,0,0</Thickness>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                </PasswordBox.Resources>
            </PasswordBox>
        </Grid>
    </Grid>
</UserControl>
